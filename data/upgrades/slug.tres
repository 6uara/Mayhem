[gd_resource type="Resource" script_class="UpgradeData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/upgrade_data.gd" id="1_upgrade"]
[ext_resource type="Script" path="res://scripts/resources/stat_modifier.gd" id="2_mod"]

[sub_resource type="Resource" id="Mod_0"]
