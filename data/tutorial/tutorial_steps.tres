[sub_resource type="Resource" id="Step_7"]
script = ExtResource("2_step")
goal = &""
title = "COLORS"
text = "CYAN is yours to use: pads, anchors, zip lines. ORANGE will hurt you. AMBER is yours to take: ammo, money, crowd gifts. MAGENTA doors are where enemies come from."
duration = 7.0
max_time = 0.0
requires_group = &""
teaches_hint = &""

[sub_resource type="Resource" id="Step_8"]
script = ExtResource("2_step")
goal = &""
title = "STYLE"
text = "Kills pay. Style pays more: headshots, kills in the air, on the hook, mid-slide, multi-kills. Your RATING multiplies style - plain kills drag it down."
duration = 7.0
max_time = 0.0
requires_group = &""
teaches_hint = &""

[sub_resource type="Resource" id="Step_9"]
