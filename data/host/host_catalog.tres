[gd_resource type="Resource" script_class="HostCatalog" load_steps=15 format=3]

[ext_resource type="Script" path="res://scripts/resources/host_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/resources/host_line_set.gd" id="2_set"]

[sub_resource type="Resource" id="Set_wave_start"]
script = ExtResource("2_set")
id = &"wave_start"
lines = Array[String](["Wave %d. Places, everyone.", "Here comes wave %d. Try to make it interesting.", "Wave %d is on the floor. The house is watching.", "Doors are open. Wave %d."])
tier = 1
priority = 2
category_cooldown = 0.0

[sub_resource type="Resource" id="Set_wave_cleared"]
script = ExtResource("2_set")
id = &"wave_cleared"
lines = Array[String](["Wave %d down. The crowd wants more.", "That is wave %d. Nobody is impressed yet.", "Wave %d, finished. We have plenty more.", "Clean enough. Wave %d goes in the book."])
tier = 1
priority = 2
category_cooldown = 0.0

[sub_resource type="Resource" id="Set_first_blood"]
script = ExtResource("2_set")
id = &"first_blood"
lines = Array[String](["First one down. The rest are watching.", "One. Only a few dozen to go.", "There it is. The floor is warm now."])
tier = 1
priority = 1
category_cooldown = 25.0

[sub_resource type="Resource" id="Set_streak"]
script = ExtResource("2_set")
id = &"streak"
lines = Array[String](["Look at this. Somebody came to work.", "The crowd is starting to learn a name.", "Well now. That is a rhythm.", "Somebody is enjoying themselves out there."])
tier = 1
priority = 1
category_cooldown = 30.0

[sub_resource type="Resource" id="Set_elite_wave"]
script = ExtResource("2_set")
id = &"elite_wave"
lines = Array[String](["Something bigger is coming. Do keep up.", "The house is sending its best. Enjoy.", "This one does not fall over politely."])
tier = 2
priority = 2
category_cooldown = 0.0

[sub_resource type="Resource" id="Set_low_health"]
script = ExtResource("2_set")
id = &"low_health"
lines = Array[String](["Oh, this is the good part.", "The crowd can smell it from here.", "Careful now. They love this bit."])
tier = 2
priority = 3
category_cooldown = 20.0

[sub_resource type="Resource" id="Set_no_damage"]
script = ExtResource("2_set")
id = &"no_damage"
lines = Array[String](["Untouched. The house does not like that.", "Not a scratch. Somebody is showing off.", "Perfect. Disgusting. Do it again."])
tier = 3
priority = 2
category_cooldown = 0.0

[sub_resource type="Resource" id="Set_too_slow"]
script = ExtResource("2_set")
id = &"too_slow"
lines = Array[String](["Slow. The crowd checks its watch.", "That took a while. Nobody claps for a while.", "We are on a schedule out here."])
tier = 1
priority = 1
category_cooldown = 0.0

[sub_resource type="Resource" id="Set_purchase"]
script = ExtResource("2_set")
id = &"purchase"
lines = Array[String](["Spending it already. Bold.", "The house appreciates your business.", "Money well spent. Probably."])
tier = 0
priority = 0
category_cooldown = 40.0

[sub_resource type="Resource" id="Set_crowd_drop"]
script = ExtResource("2_set")
id = &"crowd_drop"
lines = Array[String](["Somebody in the stands likes you. Go get it.", "That came out of row two. Do not keep them waiting.", "A gift from the cheap seats. Earn it.", "The crowd is throwing things again. This one is useful.", "Row three is feeling generous. That will not last."])
tier = 1
priority = 1
category_cooldown = 25.0

[sub_resource type="Resource" id="Set_death"]
script = ExtResource("2_set")
id = &"death"
lines = Array[String](["And that is how the story ends for most of them.", "The crowd will remember this for almost a minute.", "Every show needs one of these. Thank you for volunteering.", "Well. That happened."])
tier = 1
priority = 3
category_cooldown = 0.0

[sub_resource type="Resource" id="Set_match_won"]
script = ExtResource("2_set")
id = &"match_won"
lines = Array[String](["All ten. The house is not used to paying out.", "You survived the whole card. That is new.", "Ten waves, still upright. The crowd is yours."])
tier = 3
priority = 3
category_cooldown = 0.0

[resource]
script = ExtResource("1_catalog")
sets = Array[Resource]([SubResource("Set_wave_start"), SubResource("Set_wave_cleared"), SubResource("Set_first_blood"), SubResource("Set_streak"), SubResource("Set_elite_wave"), SubResource("Set_low_health"), SubResource("Set_no_damage"), SubResource("Set_too_slow"), SubResource("Set_purchase"), SubResource("Set_crowd_drop"), SubResource("Set_death"), SubResource("Set_match_won")])
